    "1": {
      "title": "Query 1 \u2014 Stock Risk Aggregation by Material Type",
      "description": "Groups all materials by type and computes aggregate risk metrics.\nShows which material categories have the highest average risk score\nand the total inventory value at stake per category.\nTYPE: Aggregation | Tables: risk_scores",
      "sql": "SELECT\n                material_type,\n                COUNT(*)                                        AS total_materials,\n                SUM(CASE WHEN at_risk = 1 THEN 1 ELSE 0 END)  AS at_risk_count,\n                ROUND(AVG(risk_score), 4)                       AS avg_risk_score,\n                MAX(risk_score)                                 AS max_risk_score,\n                ROUND(AVG(quantity), 2)                         AS avg_quantity,\n                SUM(quantity)                                   AS total_quantity,\n                ROUND(SUM(total_value), 2)                     AS total_inventory_value,\n                COUNT(CASE WHEN risk_level = 'CRITICAL' THEN 1 END) AS critical_count,\n                COUNT(CASE WHEN risk_level = 'HIGH'     THEN 1 END) AS high_count,\n                COUNT(CASE WHEN risk_level = 'MEDIUM'   THEN 1 END) AS medium_count,\n                COUNT(CASE WHEN risk_level = 'LOW'      THEN 1 END) AS low_count\n            FROM risk_scores\n            GROUP BY material_type\n            ORDER BY avg_risk_score DESC",
      "row_count": 10,
      "columns": [
        "material_type",
        "total_materials",
        "at_risk_count",
        "avg_risk_score",
        "max_risk_score",
        "avg_quantity",
        "total_quantity",
        "total_inventory_value",
        "critical_count",
        "high_count",
        "medium_count",
        "low_count"
      ],
